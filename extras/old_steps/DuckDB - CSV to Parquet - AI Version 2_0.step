{"description":"","displayName":"DuckDB - CSV to Parquet - AI Version 2_0.step","eTag":"\"kra9rqu2mi\"","flowMetadata":{"inputPorts":[],"outputPorts":[]},"metadataVersion":1,"name":"DuckDB - CSV to Parquet - AI Version 2_0.step","properties":{},"templates":{"SAS":"/************************************************************************\nDuckDB - CSV to Parquet Conversion\n\nPurpose: This SAS program utilizes SAS/ACCESS to DuckDB to ingest a CSV file \n         and convert it into a Parquet file.\nInput Parameters:\n- csv_file_path: Full path to the source CSV file (macro variable)\n- has_headers: Boolean (TRUE/FALSE) indicating if the CSV has a header row (macro variable)\n- parquet_output_path: Folder location for the output Parquet file (macro variable)\n- parquet_file_name: Name/prefix for the output Parquet file (macro variable)\n\nCreated: Sundaresh Sankaran\nVersion: 0.1.0 (19OCT2026)\n************************************************************************/;\n\n/* Define macro variables for input parameters */\n%let csv_file_path = ;      /* e.g., '/data/input.csv' */\n%let has_headers = TRUE;    /* TRUE or FALSE */\n%let parquet_output_path = ;/* e.g., '/data/output/' */\n%let parquet_file_name = ;  /* e.g., 'output_data.parquet' */\n\n/************************************************************************\nEXECUTION CODE\n************************************************************************/;\n\n/************************************************************************\nDefine libname for DuckDB \n************************************************************************/;\nlibname ddlib duckdb database=\":memory::mydb\";\n\n\n/* Connect to DuckDB */\nproc sql;\n    connect using ddlib;\n    \n    execute(\n        /* \n           Using DuckDB's read_csv_auto and COPY command to export to Parquet.\n           header=&has_headers handles the column detection.\n        */\n        COPY (\n            SELECT * FROM read_csv_auto('&csv_file_path', \n                                        header=&has_headers, \n                                        union_by_name=true)\n        ) TO '&parquet_output_path./&parquet_file_name.' \n        (FORMAT PARQUET);\n    ) by ddlib;\n\n    disconnect from ddlib;\nquit;"},"type":"code","ui":"{\n  \"showPageContentOnly\": true,\n  \"pages\": [\n    {\n      \"id\": \"page1\",\n      \"label\": \"DuckDB CSV to Parquet\",\n      \"type\": \"page\",\n      \"children\": [\n        {\n          \"id\": \"csv_file_path\",\n          \"type\": \"path\",\n          \"label\": \"Source CSV file path:\",\n          \"pathtype\": \"file\",\n          \"required\": true,\n          \"placeholder\": \"/path/to/source.csv\"\n        },\n        {\n          \"id\": \"has_headers\",\n          \"type\": \"dropdown\",\n          \"label\": \"CSV has headers:\",\n          \"items\": [\n            {\n              \"value\": \"TRUE\",\n              \"label\": \"TRUE\"\n            },\n            {\n              \"value\": \"FALSE\",\n              \"label\": \"FALSE\"\n            }\n          ],\n          \"required\": true\n        },\n        {\n          \"id\": \"parquet_output_path\",\n          \"type\": \"path\",\n          \"label\": \"Output folder path:\",\n          \"pathtype\": \"folder\",\n          \"required\": true,\n          \"placeholder\": \"/path/to/output/directory/\"\n        },\n        {\n          \"id\": \"parquet_file_name\",\n          \"type\": \"textfield\",\n          \"label\": \"Output Parquet file name:\",\n          \"required\": true,\n          \"placeholder\": \"output_data.parquet\"\n        }\n      ]\n    }\n  ],\n  \"syntaxversion\": \"1.3.0\",\n  \"values\": {\n    \"csv_file_path\": \"\",\n    \"has_headers\": {\n      \"value\": \"TRUE\",\n      \"label\": \"TRUE\"\n    },\n    \"parquet_output_path\": \"\",\n    \"parquet_file_name\": \"\"\n  },\n  \"promptHierarchies\": []\n}"}